# Application
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0

# LLM
OPENROUTER_API_KEY=
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL_ID=local/llama-3-8b

# OAuth (optional — Google Calendar JIT consent)
GOOGLE_OAUTH_AUTHORIZE_URL=

# Database
DATABASE_URL=postgresql://briefing:briefing@localhost:5432/briefing

# MCP
POSTGRES_MCP_HOST=localhost
POSTGRES_MCP_PORT=5443  #default: 5433
CALENDAR_MCP_HOST=localhost
CALENDAR_MCP_PORT=5444  #default: 5434

# LLM
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=local/llama-3-8b

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ADMIN_API_KEY=dev-admin-key-change-in-production

# Security
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64

# Frontend (local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost
