# Application
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0

# LLM
OPENROUTER_API_KEY=
LOCAL_LLM_ENABLED=false
# Local dev on host: http://localhost:8080/v1
# Docker reaching host LLM: http://host.docker.internal:8080/v1
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL_ID=local/llama-3-8b

# OAuth — Google Calendar (popup during consent grant)
# Optional base URL; auto-built from GOOGLE_CLIENT_ID when empty
GOOGLE_OAUTH_AUTHORIZE_URL=
# Redirect URI must be listed on your Web application OAuth client in Google Cloud
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8088
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_ID=primary

# Database — Supabase Supavisor (port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
MCP_POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# MCP transport: stdio (Option 1) or http (local TCP mock servers)
MCP_TRANSPORT=stdio

# MCP HTTP fallback (when MCP_TRANSPORT=http; local dev ports — defaults 5433/5434)
POSTGRES_MCP_HOST=localhost
# default: 5433
POSTGRES_MCP_PORT=5443
CALENDAR_MCP_HOST=localhost
# default: 5434
CALENDAR_MCP_PORT=5444

# LLM
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# maximum 3 models in the chain and check infrastructure/ai-bom.yaml for the models
# Comma-separated priority list for OpenRouter in-request fallback (first = primary)
LLM_OPENROUTER_MODELS=openai/gpt-oss-120b:free,openai/gpt-4o-mini
LLM_OPENROUTER_ROUTE=fallback
# Used when LLM_OPENROUTER_MODELS is empty
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
# Local LLM only (not the OpenRouter chain)
LLM_FALLBACK_MODEL=local/llama-3-8b

# Semantic memory — embeddings (Week 4, DB-116)
# deterministic = offline/CI (no API key); openrouter = live vectors via OpenRouter
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=openai/text-embedding-3-small
SEMANTIC_MEMORY_EMBEDDING_DIM=1536

# Observability — app (metrics exposed at /metrics; scraped by Prometheus)
# Full stack setup: docs/guidence/observability/README.md
# default: 4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ADMIN_API_KEY=dev-admin-key-change-in-production

# Multi-agent verification workflow (Verification → Adversarial → Critic → Consensus)
ENABLE_CONSENSUS_WORKFLOW=true
# LangGraph wall-clock limit; use 180+ when ENABLE_CONSENSUS_WORKFLOW=true
GRAPH_TIMEOUT_SECONDS=60
# Production: true pauses on major consensus disagreement (awaiting_human_review)
CONSENSUS_HUMAN_ESCALATION=true

# Informational — uvicorn scrape target for local Prometheus (not read by the app)
# Used in docs/guidence/observability/config/prometheus.yml via docker compose
METRICS_SCRAPE_HOST=localhost
METRICS_SCRAPE_PORT=8010

# Security
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64

# JIT credential broker (Week 5, DB-124)
# env = mediated refresh token; memory = OAuth access-token exchange + in-memory TTL cache
VAULT_MODE=env
CREDENTIAL_TTL_SECONDS=900

# Frontend — local dev: Next.js 3010, FastAPI 8010; Docker container uses nginx:80
# default: 3000
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost
