{
  "title": "Daily Briefing SLO Overview",
  "panels": [
    {
      "title": "Availability (success rate)",
      "targets": [
        {
          "expr": "daily_briefing:success_rate:5m",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "title": "Latency P95 (seconds)",
      "targets": [
        {
          "expr": "daily_briefing:latency_p95:5m",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "title": "Error rate",
      "targets": [
        {
          "expr": "daily_briefing:error_rate:5m",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "title": "Prompt cache hit rate (%)",
      "targets": [
        {
          "expr": "daily_briefing:prompt_cache_hit_rate:5m * 100",
          "legendFormat": "cache hit %"
        }
      ]
    },
    {
      "title": "Cached tokens saved per hour",
      "targets": [
        {
          "expr": "sum(rate(cached_tokens_saved_total[1h]))",
          "legendFormat": "tokens saved"
        }
      ]
    }
  ]
}
