# Production environment template — copy to .env and fill secrets before deploy

APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0

# LLM (require at least one provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-4
LLM_OPENROUTER_ROUTE=fallback
LLM_PRIMARY_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=local/llama-3-8b
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://local-llm:8080/v1
LOCAL_LLM_MODEL_ID=local/llama-3-8b

# OAuth — Google Calendar
GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_ID=primary

# Database — Supabase Supavisor (port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
MCP_POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# MCP transport: stdio (Option 1) or http (legacy TCP mock servers)
MCP_TRANSPORT=stdio

# MCP HTTP fallback (when MCP_TRANSPORT=http)
POSTGRES_MCP_HOST=postgres-mcp
POSTGRES_MCP_PORT=5443
CALENDAR_MCP_HOST=calendar-mcp
CALENDAR_MCP_PORT=5444

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
ADMIN_API_KEY=REPLACE_WITH_STRONG_SECRET

# Security
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_64

# Frontend / ingress
CORS_ORIGINS=https://briefing.example.com
