# Observability stack environment — copy to .env in this directory
# Used by docker-compose.observability.yml (NOT read by the FastAPI app)
#
# cp observability.env.example .env

# --- Prometheus scrape target ---
# Mac/Windows Docker Desktop: host.docker.internal reaches the host machine
# Linux: use 172.17.0.1 or your host IP
#
# Docker app (docker compose up): nginx exposes /metrics on :8088
APP_METRICS_TARGET=host.docker.internal:8088
#
# Local uvicorn only (uv run uvicorn ... --port 8010):
# APP_METRICS_TARGET=host.docker.internal:8010

# --- Grafana (local container) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# --- PagerDuty Events API v2 (from Service → Integrations → Events API V2) ---
# Required for Alertmanager to send alerts. Leave empty to skip PagerDuty routing.
PAGERDUTY_ROUTING_KEY=

# --- Grafana Cloud (optional — only if using cloud instead of local Grafana) ---
GRAFANA_CLOUD_STACK_URL=
GRAFANA_CLOUD_API_TOKEN=

# --- Alert routing labels ---
ALERT_ENV=development
